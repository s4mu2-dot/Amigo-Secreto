# Copia este archivo como ".env" y completa tus datos reales.
# NUNCA subas el archivo ".env" real a un repositorio público.

PORT=3000

# Servicio de correo soportado por Nodemailer (gmail, outlook, etc.)
EMAIL_SERVICE=gmail

# Tu correo remitente
EMAIL_USER=tu_correo@gmail.com

# IMPORTANTE: esto NO es tu contraseña normal de Gmail.
# Debes generar una "Contraseña de aplicación" en:
# https://myaccount.google.com/apppasswords
# (requiere tener activada la verificación en 2 pasos)
EMAIL_PASS=tu_contraseña_de_aplicacion
